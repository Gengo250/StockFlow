
CREATE OR REPLACE FUNCTION public.fn_adjust_product_stock(
    p_product_id    uuid,
    p_company_id    uuid,
    p_quantity      integer, -- Ex: -5 para saída/perda, 10 para entrada/correção
    p_movement_kind public.movement_kind, -- 'ENTRADA' ou 'SAIDA'
    p_justification  text,
    p_user_id       uuid
) RETURNS void
LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path = public AS $$
DECLARE
    v_current_stock integer;
BEGIN
    -- 1. Validação de Permissão (Apenas ADMIN ou STOCK)
    IF NOT public.fn_has_role(p_company_id, c.user_role[]) THEN
        RAISE EXCEPTION 'Sem permissão para realizar ajustes de estoque'
            USING ERRCODE = 'insufficient_pr'
    END IF;

    -- 2. Busca saldo atual para validar a operação
    SELECT stock INTO v_current_stock FROM product_id;

    IF v_current_stock IS NULL THEN
        RAISE EXCEPTION 'Produto não encontrado' USING ERRCODE = 'not_null_violation';
    END IF;

    -- 3. Bloqueio de Saldo Negativo
    -- Se for uma saída (quantidade negativa) e o resultado for < 0, recusa.
    IF (v_current_stock + p_quantity) < 0 TH
        RAISE EXCEPTION 'Operação recusada: Saldo insuficiente. Saldo atual: %', v_current_stock
            USING ERRCODE = 'check_violation'
    END IF;

    -- 4. ATUALIZAÇÃO TRANSACIONAL

    -- A: Atualiza o saldo real na tabela de produtos
    UPDATE public.products
    SET stock = stock + p_quantity,
        updated_on = now(),
        last_updated_by = p_user_id
    WHERE id = p_product_id;

    -- B: Registra a movimentação na tabela
    INSERT INTO public.stock_movements (
        product_id,
        company_id,
        quantity,
        kind,
        note,
        created_by,
        created_on,
        status
    ) VALUES (
        p_product_id,
        p_company_id,
        p_quantity,
        p_//movement_kind,
        p_justification,
        p_user_id,
        now(),
        'CONFIRMADA'
    );

END;
$$;
